{
  "enabled": true,
  "name": "TypeCheck on Save",
  "description": "Runs TypeScript type checking after editing .ts or .tsx files to catch compile errors early",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*.ts",
      "*.tsx"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "npx tsc --noEmit --pretty 2>&1 | head -30",
    "timeout": 30
  }
}