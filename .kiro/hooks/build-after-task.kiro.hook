{
  "enabled": true,
  "name": "Build After Task",
  "description": "After completing a spec task, runs TypeScript type checking to verify the app still compiles cleanly",
  "version": "1",
  "when": {
    "type": "postTaskExecution"
  },
  "then": {
    "type": "runCommand",
    "command": "npx tsc --noEmit --pretty 2>&1 | head -30; npm test 2>&1 | tail -20",
    "timeout": 60
  }
}
